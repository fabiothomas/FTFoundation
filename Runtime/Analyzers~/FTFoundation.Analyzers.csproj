<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- RS2008 wants a Shipped/Unshipped release-tracking file pair, which is meant for analyzers
         published independently on NuGet with their own release cadence. This one ships bundled
         with FTFoundation's own versioning instead, so that convention doesn't apply here. -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned to 3.8 (not a later version) because Unity's own bundled Roslyn only supports
         Microsoft.CodeAnalysis 3.8 for custom analyzers/suppressors, per Unity's manual. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="3.8.0" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" PrivateAssets="all" />
  </ItemGroup>

</Project>
