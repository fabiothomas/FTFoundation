<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- RS2008 wants a Shipped/Unshipped release-tracking file pair, which is meant for analyzers
         published independently on NuGet with their own release cadence. This one ships bundled
         with FTFoundation's own versioning instead, so that convention doesn't apply here. -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
    <!-- This folder also holds FTFoundation.Analyzers.CodeFixes.csproj (a separate assembly
         Listing this project's files explicitly instead of relying on directory-exclusion behavior. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="FTFoundationConventionAnalyzer.cs" />
    <Compile Include="ReflectionInjectionSuppressor.cs" />
    <Compile Include="BuildGateSymbols.cs" />
    <Compile Include="BuildGateDirectives.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pinned to 3.8 (not a later version) because Unity's own bundled Roslyn only supports
         Microsoft.CodeAnalysis 3.8 for custom analyzers/suppressors, per Unity's manual. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="3.8.0" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" PrivateAssets="all" />
  </ItemGroup>

</Project>
